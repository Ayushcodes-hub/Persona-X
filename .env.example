# ==============================================================================
# PERSONA-X Universal Intelligence Platform Configuration
# ==============================================================================

# Core Application
APP_NAME=PERSONA-X
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database Infrastructure
# For local development: sqlite:///./data/persona_x.db
# For production PostgreSQL / Supabase: postgresql+psycopg2://user:password@db.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./data/persona_x.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Supabase Production Configuration (Optional in dev, required in production)
# Obtain from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Primary AI Provider: Groq
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alternative AI Providers (Provider-agnostic routing fallback)
# Google Gemini - Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OpenAI - Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic - Obtain from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Default Active AI Provider (groq | gemini | openai | anthropic)
DEFAULT_AI_PROVIDER=groq

# Authentication & Security
JWT_SECRET_KEY=change-this-in-production-to-a-random-64-character-hex-string
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Research Engine Limits & Budgets
RESEARCH_MAX_SOURCES=50
RESEARCH_MAX_DEPTH=3
RESEARCH_TIMEOUT_SECONDS=30
RESEARCH_WORKER_COUNT=4
RESEARCH_MAX_QUERIES_PER_JOB=8
RESEARCH_MAX_ATTEMPTS=3
RESEARCH_RETRY_BASE_SECONDS=2.0
RESEARCH_RATE_LIMIT_PER_MINUTE=30
RESEARCH_STALE_JOB_SECONDS=1800
RESEARCH_CACHE_TTL_SECONDS=86400
RESEARCH_AUTO_START=false
